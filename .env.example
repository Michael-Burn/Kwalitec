# Kwalitec Environment Configuration
# Copy this file to .env and fill in your values.

# Application environment: development or production
FLASK_APP=run.py
FLASK_ENV=development
APP_ENV=development

# Local HTTP port for ``flask run`` / ``python run.py``.
# Default 5001 — macOS AirPlay Receiver often owns TCP 5000 and returns an
# empty HTTP 403 (completely blank page) for any path, including /console/studio/.
FLASK_RUN_PORT=5001
FLASK_RUN_HOST=127.0.0.1

# Secret key for session signing and CSRF protection.
# Generate a strong random key for production use:
#   python3 -c "import secrets; print(secrets.token_hex(32))"
SECRET_KEY=change-this-secret-key

# Database URL (optional — SQLite is used when not set)
# For PostgreSQL: postgresql+psycopg://user:password@host:5432/kwalitec
# DATABASE_URL=postgresql+psycopg://user:password@host:5432/kwalitec

# Administrator credentials — used by create-admin / sync-admin and StartupService
# (first boot only). If local DB password drifts from .env, run: flask sync-admin
ADMIN_EMAIL=admin@example.com
ADMIN_PASSWORD=change-this-password

# Legacy Founder bootstrap allowlist (comma-separated). Prefer durable RBAC roles
# (user_roles / user_capabilities). Matching emails still grant Console access and
# sync the Founder role on first authorised access (PR-001 transition bridge).
# FOUNDER_EMAILS=founder@example.com

# Production reverse-proxy / HTTPS (Render terminates TLS).
# TRUSTED_PROXY_HOPS=1
# PREFERRED_URL_SCHEME=https
#
# Canonical public origin for custom domains (no trailing slash / path).
# Required for production sitemap, robots.txt Sitemap:, and OG/canonical tags.
# Example: https://app.kwalitec.com  (or https://kwalitec.onrender.com before cutover)
# APP_URL=https://app.example.com
#
# Optional Flask SERVER_NAME (host[:port]) for offline absolute URL generation.
# Leave unset on Render during *.onrender.com → custom-domain cutover so both
# Host headers continue to work via ProxyFix.
# SERVER_NAME=app.example.com
#
# Optional session cookie Domain. Leave unset for host-only cookies (recommended
# for a single custom hostname). Set only to share cookies across subdomains
# (e.g. .example.com). Never point this at the old *.onrender.com host after cutover.
# SESSION_COOKIE_DOMAIN=

# PostgreSQL pool tuning (ignored for SQLite).
# DB_POOL_SIZE=5
# DB_MAX_OVERFLOW=10
# DB_POOL_RECYCLE=1800

# Observability thresholds.
# SLOW_REQUEST_THRESHOLD_MS=1000
# HEALTH_ALERT_DB_LATENCY_MS=500
# PROFILE_SQL=0
# SESSION_LIFETIME_HOURS=12

# Curriculum Studio document storage (Phase 1). PDF bytes are never stored in SQL.
# DOCUMENT_STORAGE_ROOT=instance/curriculum_documents
# DOCUMENT_MAX_BYTES=26214400
# CIP_AUTO_RUN=true


# Educational Intelligence Internal Alpha (developer daily use only — not public).
# When set, enables the EI Recommendation card on the dashboard (orchestrator +
# recommendations only). Missions / explainability / progress stay off.
# Requires an active study plan with a curriculum attached.
# KWALITEC_EI_INTERNAL_ALPHA=1

# Version 2 dual-run / cutover (ADR-007). Safe defaults keep V1 as primary home.
# Production G12 matrix: docs/production/VERSION_1_FLAG_MATRIX.md (EI-001.3).
# KWALITEC_V2_STUDENT_EXPERIENCE=1   # Show /student entry from dashboard
# KWALITEC_V2_DURABLE_STORE=1        # Persist Experience/Session via SQLAlchemy
# KWALITEC_V2_INJECT_ENGINES=1       # Wire opaque Phase I engine bridges
# KWALITEC_V2_SEED_DEMO=0            # Disable demo seed when durable (recommended)
# KWALITEC_V2_FOUNDER_INTELLIGENCE=1 # Enable Founder Intelligence signals
# KWALITEC_V2_SOLE_RUNTIME=1         # EP-007.1 canonical journey — / → /student (ONLY after evidence gates)

# KWP-002 Commercial Loop Profile — enables the SR student-value bundle:
# Session Primary, Substance, Completion Product, Evidence Gate, Twin daily
# loop, Progress singularity. Individual SR_* vars still override when set.
# KWALITEC_COMMERCIAL_LOOP=1
# SR_COMMERCIAL_LOOP=1               # Alias for KWALITEC_COMMERCIAL_LOOP
# SR_SESSION_PRIMARY=0               # Force OFF even when Commercial Loop is ON
# SR_PILOT_MARK_COMPLETE=1           # Emergency only — never part of Commercial Loop

# V1S-002 Curriculum Authority Cutover (Founder → Student bridge / PI-002A).
# Development default: when APP_ENV=development and none of these are set,
# discovery + Runtime C enrolment auto-enable. Dogfood subjects CS1/CB2/CM1
# are always on the effective Runtime C allowlist when enrolment is ON —
# published packages become the sole student curriculum authority.
# KWALITEC_FOUNDER_STUDENT_BRIDGE=1          # Umbrella: discovery + Runtime C enrolment
# KWALITEC_PUBLISHED_SUBJECT_DISCOVERY=1     # Surface Published category in Choose Exam
# KWALITEC_RUNTIME_C_ENROLMENT=1             # Allow PUBLISHED_CURRICULUM enrolment
# KWALITEC_RUNTIME_C_SUBJECT_ALLOWLIST=CS1,CB2,CM1  # Extra subjects (dogfood already unioned)
#
# V1S-005 exclusive CS1 dogfood week checklist (also enable Commercial Loop):
# 1. KWALITEC_RUNTIME_C_ENROLMENT=1 (or KWALITEC_FOUNDER_STUDENT_BRIDGE=1)
# 2. SR_COMMERCIAL_LOOP=1  (or set SR_SESSION_PRIMARY=1 + SR_PROGRESS_SINGULARITY=1)
# 3. Founder-publish an active CS1 package (Curriculum Studio → Publish)
# 4. Enrol founder account on Runtime C CS1; confirm /founder/v1-readiness package gate

# MS-003 Adaptive Learning Engine (A0–A6). Safe default OFF — no UX change.
# KWALITEC_ADAPTIVE_ENGINE=1         # Construct Adaptive Engine Adapter + Assembler
# KWALITEC_ADAPTIVE_SHADOW=1         # Shadow execution + A6 soak (observational only)
# KWALITEC_ADAPTIVE_ENGINE_SHADOW=1  # Alias for KWALITEC_ADAPTIVE_SHADOW
# KWALITEC_ADAPTIVE_AUTHORITY=1      # A4: eligible adaptive may serve Experience
# KWALITEC_ADAPTIVE_INTELLIGENCE=1   # Optional umbrella enabling Adaptive Engine
# Explainability Gate (A3) runs only when ENGINE + SHADOW are both enabled.
# Experience cutover (A4) requires ENGINE + SHADOW + AUTHORITY; else RecommendationService.
# A6 Shadow Soak compares RecommendationService vs Adaptive Engine without UX influence.

# MS-004 Student Digital Twin (T0–T6) + EP-001.1 Foundation. Safe default OFF — no UX change.
# KWALITEC_DIGITAL_TWIN=1            # Twin contracts + facets + snapshots + explainability + Adaptive TwinInput + Experience projection port + Foundation DI
# T4: Adaptive may consume TwinSnapshots read-only when ON — no Twin persistence or Experience cutover.
# EP-001.1: Experience StudentTwinPort authority (requires DIGITAL_TWIN; default OFF).
# KWALITEC_DIGITAL_TWIN_AUTHORITY=1  # Serve Runtime-A-grounded Twin Foundation via StudentTwinPort (falls back to ExperienceTwinAdapter)
# EP-001.2: When DIGITAL_TWIN is ON, PlanningService.build_daily_study_plan / MissionOptimizer
# consume CanonicalLearnerState for adaptive daily plan projections (no separate planner flag).
# EP-001.3: When DIGITAL_TWIN is ON, ReadinessService.build_readiness_intelligence consumes
# CanonicalLearnerState (+ optional planner daily plan) for readiness intelligence assessments
# (no separate readiness-intelligence flag; legacy getters unchanged for collector safety).
# EP-001.4: When DIGITAL_TWIN is ON, RecommendationService.build_study_insights consumes
# CanonicalLearnerState + planner daily plan + readiness intelligence for student-facing
# study guidance (communication only; no separate insight flag; legacy generate_recommendations unchanged).
# EP-002.1: build_* APIs emit structured consumer-chain observability (invocation / latency /
# outcome / limitation codes / Twin+Authority flags). Dual-run fingerprint compare is
# diagnostic-only in non-production when Twin is ON — never changes HTTP responses.
# EP-002.2: Nested Planner → Readiness → Insight share one CanonicalLearnerState per composition
# (assemble vs share-hit telemetry). MissionOptimizer is quarantined — do not wire.
# EP-002.3: Non-prod Twin + Authority soak harness under consumer_chain (observational only).
# EP-002.4: When DIGITAL_TWIN is ON in non-production, generate_recommendations may fail-open
# dual-run build_study_insights for structured comparison telemetry only — student still
# receives legacy recommendations. Production / APP_ENV=production skips dual-run.
# EP-002.5: Gated HTTP cutover on dashboard/home (requires DIGITAL_TWIN; default OFF).
# KWALITEC_STUDY_INSIGHTS_CUTOVER=1  # Serve Twin Study Insights projection when eligible;
#                                      # legacy generate_recommendations remains fail-open fallback.
#                                      # Production / APP_ENV=production remains ineligible.
# EP-002.6: Gated readiness dual-run + HTTP cutover on dashboard/analytics (requires
# DIGITAL_TWIN; default OFF). Dual-run runs when Twin ON in non-prod and cutover OFF.
# KWALITEC_READINESS_INTELLIGENCE_CUTOVER=1  # Serve Twin readiness projection when eligible;
#                                      # legacy readiness surface remains fail-open fallback.
#                                      # Collectors continue using pure get_overall_readiness.
#                                      # Production / APP_ENV=production remains ineligible.
# EP-002.7: Gated daily plan dual-run + HTTP cutover on dashboard/missions (requires
# DIGITAL_TWIN; default OFF). Dual-run runs when Twin ON in non-prod and cutover OFF.
# KWALITEC_DAILY_PLAN_CUTOVER=1        # Serve Twin build_daily_study_plan projection when
#                                      # eligible; legacy generate_today_mission remains
#                                      # fail-open fallback + sole ORM persistence authority.
#                                      # MissionOptimizer remains quarantined.
#                                      # Production / APP_ENV=production remains ineligible.
# Production defaults remain Twin OFF / Authority OFF / Cutover OFF.
# Shadow Validation + Adaptive TwinInput are bundled under DIGITAL_TWIN (no separate env flags).
# Twin stack quarantine: knowledge/architecture/TWIN_STACK_QUARANTINE.md

# MS-005 Learning Strategy & Intervention Engine (S0/S1). Safe default OFF — no UX change.
# KWALITEC_STRATEGY_ENGINE=1         # Construct Strategy Engine + assembler + planners (no Experience cutover)

# MS-006 Learning Evidence & Experimentation Platform (E0–E5). Safe default OFF — no UX change.
# KWALITEC_EVIDENCE_PLATFORM=1       # Construct Evidence Platform DI + observational Shadow Validation (no policy deployment)

# Programme II P2-MS001 Unified Student Journey Framework. Safe default OFF — no UX change.
# KWALITEC_UNIFIED_JOURNEY=1         # Journey Coordinator + guided study session + Home mission architecture (no educational logic)

# Programme II P2-MS006 Experience Observation Bridge. Safe default OFF — no UX change.
# Independently controllable from KWALITEC_EVIDENCE_PLATFORM.
# KWALITEC_EXPERIENCE_OBSERVATION=1  # Publish immutable ExperienceObservation → Evidence public intake (no interpretation)

# Programme II P2-MS007 Experience Observability & Diagnostics. Safe default OFF — no UX change.
# Independently controllable from observation / evidence / journey flags.
# KWALITEC_EXPERIENCE_DIAGNOSTICS=1  # JourneyTrace + observation counters + pipeline health (internal ops only)

# Programme II P2-MS008 Experience Feedback Loop. Safe default OFF — no UX change.
# Independently controllable from all previous flags. Home "Your Journey" when Unified Journey is also ON.
# KWALITEC_EXPERIENCE_FEEDBACK=1     # Surface factual Evidence summaries on Home (display-only; no adaptation)

# EP-003.4 Learning Feedback Loop. Safe default OFF — no educational decision change.
# Independently controllable. Records observed plan / recommendation / study interactions only.
# KWALITEC_LEARNING_FEEDBACK=1       # Record behavioural evidence (no adaptation / Twin writes)
# KWALITEC_PERSONAL_LEARNING_PROFILE=1  # Aggregate observed behavioural profile (no educational authority)

# Programme II P2-MS009 Evidence Advisory Layer. Safe default OFF — no behaviour change.
# Independently controllable from all previous flags. Runtime A injection point only.
# KWALITEC_EVIDENCE_ADVISORY=1       # Expose factual EvidenceAdvisory to Runtime A (no recommendation changes)

# Programme II P2-MS010 Study Recovery Engine. Safe default OFF — no behaviour change.
# Independently controllable from all previous flags. Architecture / advisory placeholder only.
# KWALITEC_RECOVERY_PLANNER=1        # Expose RecoveryPlanCandidate to Runtime A (ignored for decisions)

# Programme II P2-MS011 Advisory Decision Simulation. Safe default OFF — no behaviour change.
# Independently controllable from all previous flags. Parallel comparison / explainability only.
# KWALITEC_DECISION_SIMULATION=1     # Simulate advisory-informed recommendations (never student-facing)

# Programme II P2-MS012 Advisory Evaluation Framework. Safe default OFF — no behaviour change.
# Independently controllable from all previous flags. Operational metrics / review export only.
# KWALITEC_ADVISORY_EVALUATION=1     # Evaluate simulated recommendation differences (never Runtime A)

# Programme III P3-MS001 Controlled Advisory Activation. Safe default OFF — reversible.
# Independently controllable. Runtime A may consume exactly one approved Evidence Advisory
# field (consistency_summary) under policy / freshness / rollout governance.
# KWALITEC_CONTROLLED_ADVISORY=1
# KWALITEC_CONTROLLED_ADVISORY_ROLLOUT_PERCENTAGE=0   # 0–100 staged rollout (default 0)
# KWALITEC_CONTROLLED_ADVISORY_MAX_AGE_HOURS=168      # Advisory freshness window (hours)
# KWALITEC_CONTROLLED_ADVISORY_EFFECTIVE_FROM=1970-01-01T00:00:00+00:00

# Programme III P3-MS002 Advisory Outcome Measurement. Safe default OFF — no behaviour change.
# Independently controllable from all previous flags. Operational rollout observations only.
# KWALITEC_ADVISORY_OUTCOME_MEASUREMENT=1  # Measure controlled advisory rollout outcomes (never Runtime A)

# Programme III P3-MS003 Recommendation Policy Framework. Safe default OFF.
# Independently controllable. Declarative policy for advisory influence on Runtime A
# recommendations; Runtime A remains sole educational authority.
# KWALITEC_RECOMMENDATION_POLICY=1
# KWALITEC_RECOMMENDATION_POLICY_ID=recommendation-policy-p3-ms003
# KWALITEC_RECOMMENDATION_POLICY_VERSION=p3.ms003.1
# KWALITEC_RECOMMENDATION_POLICY_EFFECTIVE_FROM=1970-01-01T00:00:00+00:00

# Programme III P3-MS004 Policy-Governed Weight Application. Safe default OFF.
# Independently controllable. Runtime A may apply exactly one bounded weight rule
# from consistency_summary under policy / freshness / rollout governance.
# KWALITEC_POLICY_WEIGHTING=1
# KWALITEC_POLICY_WEIGHTING_ROLLOUT_PERCENTAGE=0   # 0–100 staged rollout (default 0)
# KWALITEC_POLICY_WEIGHTING_MAX_AGE_HOURS=168      # Advisory freshness window (hours)
# KWALITEC_POLICY_WEIGHTING_MAX_ADJUSTMENT=0.05    # ±5% bound (policy-configurable)
# KWALITEC_POLICY_WEIGHTING_DIVERGENCE_TOLERANCE=0.001
# KWALITEC_POLICY_WEIGHTING_EFFECTIVE_FROM=1970-01-01T00:00:00+00:00
# KWALITEC_POLICY_WEIGHTING_POLICY_ID=recommendation-policy-p3-ms004
# KWALITEC_POLICY_WEIGHTING_POLICY_VERSION=p3.ms004.1

# Programme IV P4-MS001 Controlled Educational Effectiveness Trial. Safe default OFF.
# Independently controllable. Deterministic cohort comparison of baseline vs
# policy-weighted recommendations (consistency_summary only). No mastery inference.
# KWALITEC_EDUCATIONAL_TRIALS=1
# KWALITEC_EDUCATIONAL_TRIAL_ID=educational-trial-p4-ms001
# KWALITEC_EDUCATIONAL_TRIAL_POLICY_VERSION=p3.ms004.1
# KWALITEC_EDUCATIONAL_TRIAL_ROLLOUT_PERCENTAGE=0   # 0–100 treatment cohort (default 0)
# KWALITEC_EDUCATIONAL_TRIAL_STATUS=active
# KWALITEC_EDUCATIONAL_TRIAL_START_DATE=2026-07-25
# KWALITEC_EDUCATIONAL_TRIAL_END_DATE=2026-08-25
# KWALITEC_EDUCATIONAL_TRIAL_ROLLOUT_SALT=kwalitec-educational-trial-p4-ms001

# Programme IV P4-MS002 Longitudinal Learning Evidence Repository. Safe default OFF.
# Independently controllable. Append-only evidence storage for educational
# observations (sessions / missions / reflections / advisory / trials).
# Never influences Runtime A. No analytics or policy mutation in this milestone.
# KWALITEC_LONGITUDINAL_EVIDENCE=1

# Programme IV P4-MS003 Educational Evidence Review Workspace. Safe default OFF.
# Independently controllable. Read-only query / timeline / export over
# longitudinal evidence for human inspection. Never modifies Runtime A,
# recommendations, policy, or educational behaviour.
# KWALITEC_EVIDENCE_REVIEW=1

# ADR-027 M0 Decision Boundary. Safe default OFF. Explicit env only (never
# inherited from Commercial Loop). When ON, Runtime C daily sittings are
# decided by SittingDecisionOrchestrator + Policy V0; materialisation only
# remains in EducationalRuntimeEngineService. Ship dark until deliberate soak.
# KWALITEC_ADR027_M0_DECISION_BOUNDARY=1

# Internal Alpha operational metadata (ALPHA-001) — presentation / support only.
# KWALITEC_BUILD_NUMBER=local
# KWALITEC_BUILD_DATE=2026-07-23
# KWALITEC_GIT_COMMIT=
# KWALITEC_SUPPORT_CONTACT=alpha-support@kwalitec.com

# Educational Operating System (src/) — APP-004 production readiness
# APP_VERSION=2.0.0
# LOG_LEVEL=INFO
# STRUCTURED_LOGGING=1
# EOS_DATABASE_URL=postgresql+psycopg://user:password@host:5432/kwalitec
#
# AI enrichment is optional presentation-only (ADR-008). Disable for deterministic-only runs.
# AI_PROVIDER=openai          # openai | anthropic | gemini | none
# AI_MODEL=gpt-4o-mini
# AI_API_KEY=                 # or OPENAI_API_KEY / ANTHROPIC_API_KEY / GEMINI_API_KEY
# AI_TIMEOUT_SECONDS=15
# AI_MAX_RETRIES=2
# AI_RETRY_BACKOFF_SECONDS=0.25
# AI_ENRICHMENT_DISABLED=0
